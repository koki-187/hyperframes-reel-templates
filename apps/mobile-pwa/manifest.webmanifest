{
  "name": "14DNA-ENGINE",
  "short_name": "14DNA",
  "description": "14の美学を、一つのエンジンへ。SNS専用の画像・動画生成PWA。",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#07090d",
  "theme_color": "#07090d",
  "lang": "ja",
  "categories": ["design", "productivity", "photo", "video"],
  "icons": [
    {"src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "X投稿を作成", "short_name": "X", "url": "./?format=x"},
    {"name": "Reelsを作成", "short_name": "Reels", "url": "./?format=reels"},
    {"name": "Storyを作成", "short_name": "Story", "url": "./?format=story"}
  ],
  "share_target": {
    "action": "./?shared=1",
    "method": "GET",
    "params": {"title": "title", "text": "text", "url": "url"}
  }
}
