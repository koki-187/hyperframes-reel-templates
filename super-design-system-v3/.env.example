# 14DNA-ENGINE local Render Node
PORT=4314
DNA_BIND_HOST=127.0.0.1

# Required when exposing the Render Node over Tailscale/LAN.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DNA_RENDER_TOKEN=

# Comma-separated PWA origins.
DNA_ALLOWED_ORIGINS=https://koki-187.github.io
DNA_RENDER_URL=http://127.0.0.1:4314

# Final PNG/MP4 normally requires a verified Japanese font in private-fonts/.
# Keep false in production. true is only for local diagnostics/CI.
DNA_ALLOW_FONT_FALLBACK=false

# Local ComfyUI
COMFYUI_URL=http://127.0.0.1:8188
FLUX_UNET=flux1-schnell.safetensors
FLUX_CLIP_L=clip_l.safetensors
FLUX_T5=t5xxl_fp16.safetensors
FLUX_VAE=ae.safetensors
LTX_MODEL=ltx-video.safetensors

# Paid provider fallback must remain disabled.
PAID_API_AUTO_FALLBACK=false
