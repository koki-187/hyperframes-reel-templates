# 14DNA-ENGINE local Render Node
PORT=4314
DNA_BIND_HOST=127.0.0.1

# Required when exposing the Render Node over Tailscale/LAN.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DNA_RENDER_TOKEN=

# Comma-separated PWA origins allowed to call the Render Node.
# Example: https://koki-187.github.io,http://192.168.1.10:4173
DNA_ALLOWED_ORIGINS=

# Claude Code MCP connection
DNA_RENDER_URL=http://127.0.0.1:4314

# Paid provider fallback must remain disabled by default.
PAID_API_AUTO_FALLBACK=false
