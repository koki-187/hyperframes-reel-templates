# 14DNA-ENGINE private local Render Node
NODE_ENV=production
PORT=4314
DNA_BIND_HOST=127.0.0.1

# REQUIRED. Generate unique tokens:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DNA_RENDER_TOKEN=
DNA_ADMIN_TOKEN=

# Only the private Tailscale origin or localhost PWA origin.
# Example: https://workstation.tail1234.ts.net
DNA_ALLOWED_ORIGINS=

# Static device allowlist (legacy/default mode).
DNA_ALLOWED_DEVICE_IDS=
DNA_REQUIRE_DEVICE_ID=true

# One-time enrollment registry. When true, DNA_ALLOWED_DEVICE_IDS is replaced
# by runtime/security/devices/devices.json and one-time enrollment codes.
DNA_DYNAMIC_DEVICE_REGISTRY=false
DNA_DEVICE_REGISTRY_PEPPER=
DNA_ENROLLMENT_CODE_TTL_MINUTES=15

# Audit records contain hashed device/IP identifiers and redacted values only.
DNA_AUDIT_PEPPER=
DNA_AUDIT_RETENTION_DAYS=30

# Never bypass authentication unless performing an isolated local diagnostic.
DNA_ALLOW_LOCAL_NO_TOKEN=false

# Premium Quality Gate. Keep true in every production environment.
DNA_REQUIRE_PREMIUM_GATE=true
DNA_QUALITY_MINIMUM_LEVEL=RELEASE

# Anti-abuse and anti-replay controls.
DNA_RATE_WINDOW_MS=60000
DNA_RATE_MAX=60
DNA_REPLAY_WINDOW_MS=300000
DNA_JSON_LIMIT=2mb

# Delete jobs, QA reports and generated outputs after this many hours.
DNA_RETENTION_HOURS=24

# Final PNG/MP4 requires a verified Japanese font in private-fonts/.
DNA_ALLOW_FONT_FALLBACK=false

# Local ComfyUI. Keep bound to localhost only.
COMFYUI_URL=http://127.0.0.1:8188
FLUX_UNET=flux1-schnell.safetensors
FLUX_CLIP_L=clip_l.safetensors
FLUX_T5=t5xxl_fp16.safetensors
FLUX_VAE=ae.safetensors
LTX_MODEL=ltx-video.safetensors

# Paid provider fallback must remain disabled.
PAID_API_AUTO_FALLBACK=false
